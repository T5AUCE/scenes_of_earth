{
	"python.defaultInterpreterPath": "/usr/local/bin/python",
	"files.watcherExclude": {
		"**/.git/objects/**": true,
		"**/node_modules/**": true,
		"**/dist/**": true,
		"**/__pycache__/**": true,
		"**/.pytest_cache/**": true,
		"data/**": true,
		"web/.trial-cache/**": true,
		".claude/results/**": true,
		".claude/logs/**": true
	},
	"search.exclude": {
		"data/**": true,
		"web/.trial-cache/**": true,
		".claude/results/**": true
	}
}
