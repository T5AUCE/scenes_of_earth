{
	"name": "Scenes of Earth",

	"image": "mcr.microsoft.com/devcontainers/python:3.12",

	"features": {
		"ghcr.io/devcontainers/features/node:1": { "version": "lts" },
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/powershell:1": { "version": "latest" },
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},

	"portsAttributes": {
		"8000": { "label": "api", "onAutoForward": "silent" },
		"5173": { "label": "web", "onAutoForward": "notify" },
		"4174": { "label": "reports", "onAutoForward": "silent" }
	},
	"otherPortsAttributes": { "onAutoForward": "ignore" },

	"postCreateCommand": "sudo chown vscode:vscode ~/.local ~/.local/share && sudo chown -R vscode:vscode ~/.local/share/opencode ~/.config/opencode && pip install -e '.[import,dev]' && npm config set prefix ~/.npm-global && npm install -g @anthropic-ai/claude-code opencode-ai@1.19.3 && { [ ! -f .secrets/cdsapirc ] || ln -sfn \"$PWD/.secrets/cdsapirc\" ~/.cdsapirc; } && (cd web && npm ci && bash scripts/visual-trial/setup.sh)",

	// Unconfined seccomp/AppArmor lets opencode-agent.sh use bwrap's read-only sandbox.
	"runArgs": ["--security-opt", "seccomp=unconfined", "--security-opt", "apparmor=unconfined"],
	// Volumes keep Claude Code and opencode logins (and opencode sessions) across rebuilds.
	"mounts": [
		"source=claude-code-config,target=/home/vscode/.claude,type=volume",
		"source=opencode-data,target=/home/vscode/.local/share/opencode,type=volume",
		"source=opencode-config,target=/home/vscode/.config/opencode,type=volume"
	],
	"containerEnv": { "CLAUDE_CONFIG_DIR": "/home/vscode/.claude" },
	"remoteEnv": { "PATH": "/home/vscode/.local/bin:/home/vscode/.npm-global/bin:${containerEnv:PATH}" },

	"customizations": {
	"vscode": {
		"settings": { "terminal.integrated.defaultProfile.linux": "pwsh" }
	}
}
}
