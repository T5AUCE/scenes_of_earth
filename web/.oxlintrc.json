{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "env": { "browser": true, "es2024": true },
  "options": { "typeAware": true },
  "ignorePatterns": ["dist/**", "public/**", ".trial-cache/**"],
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ],
    "eslint/eqeqeq": ["error", "smart"],
    "eslint/no-else-return": "warn",
    "unicorn/no-lonely-if": "warn",
    "oxc/no-accumulating-spread": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": [
              "test",
              "it",
              "describe",
              "suite",
              "before",
              "after",
              "beforeEach",
              "afterEach"
            ]
          }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-for-in-array": "error",
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": true }],
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/switch-exhaustiveness-check": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",

    "unicorn/no-useless-spread": "off",
    "unicorn/no-new-array": "off",
    "unicorn/require-post-message-target-origin": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-add-event-listener": "off",
    "react/react-in-jsx-scope": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/no-did-update-set-state": "off",
    "import/no-unassigned-import": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/unbound-method": "off",
    "typescript/restrict-template-expressions": "off",
    "typescript/consistent-return": "off",
    "typescript/no-extraneous-class": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-shadow": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs", "vite.config.ts", "**/*.test.ts", "**/*.test.tsx"],
      "env": { "node": true }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs"],
      "rules": { "eslint/no-loss-of-precision": "off" }
    }
  ]
}
